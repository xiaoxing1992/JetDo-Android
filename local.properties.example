## This file must *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.
#
# Location of the Android SDK. This is usually set automatically by Android Studio.
sdk.dir=/path/to/Android/sdk

# ===== Release 签名（可选）=====
# 不配也能构建：release 会产出未签名包，debug 不受影响。
# Generate keystore with: keytool -genkey -v -keystore jetdo.jks -keyalg RSA -keysize 2048 -validity 10000 -alias jetdo
jetdo.release.storeFile=/path/to/jetdo.jks
jetdo.release.storePassword=your_keystore_password
jetdo.release.keyAlias=jetdo
jetdo.release.keyPassword=your_key_password

# ===== 推送中继（可选）=====
# 推送走 app/src/main/assets/relay-config.json（endpoint + VAPID 公钥），不在这里配。
# 本应用不做任何远程崩溃上报：崩溃现场只写本机日志，「设置 → 诊断日志」可查看/导出。
