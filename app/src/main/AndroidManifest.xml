<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 推送权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 下载/图片保存走应用专属目录 getExternalFilesDir，API 29+ 无需存储权限 -->

    <application
        android:name=".JetDoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JetDo"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true">

        <!--
          configChanges：折叠屏展开/折叠、投屏、自由窗口拖动都会触发 screenSize /
          smallestScreenSize / screenLayout / orientation / density 这一组配置变更。
          不声明的话每次形态切换都销毁重建 Activity，Compose 整棵树连同 navController 栈、
          WebView 会话、各页滚动位置一起重来 —— 用户观感是「一展开 App 就重启了」，
          与官方「应用连续性」的要求正好相反。

          orientation 在某些折叠屏尤其关键：厂商会强制部分应用保持横屏（展开后外屏竖持、
          内屏横持，rotation 与握持方向不一致），不接管就会被反复重建。
          density 是为了三折叠内外屏密度不同，以及投屏场景。

          uiMode / fontScale / locale 故意不加：深色模式、字体大小、语言变化的正确响应
          本就是重建，符合系统预期。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:theme="@style/Theme.JetDo.Splash"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              深链接：推送通知跳转。

              launchMode="singleTop" 是配套的硬要求：没有它，App 活着时点通知会再起一个
              MainActivity 实例（standard 模式），Compose 整棵树连同 navController 栈、
              WebView 会话一起重建，用户观感是「点一下通知 App 重开了一遍」。

              原先这里挂着 android:autoVerify="true" —— 那是 http/https App Links 的东西，
              对自定义 scheme 没有任何作用，Android 也不会去校验，纯属误导，已去掉。

              host 不写死成 notification：解析统一在 DeepLinkEventBus.parse 里做，
              以后加 jetdo://topic/123 这类形态不用再动 Manifest。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jetdo" />
            </intent-filter>
        </activity>

        <!-- 日志文件分享（FileProvider：调试日志导出） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
