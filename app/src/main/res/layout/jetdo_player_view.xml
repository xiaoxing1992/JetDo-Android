<?xml version="1.0" encoding="utf-8"?>
<!--
  帖内视频播放卡用的 media3 PlayerView。
  关键点:surface_type 必须是 texture_view。
  SurfaceView 是独立图层,在 Compose 里要靠 AndroidView 的 punch-hole 挖洞才能透出来;
  而本卡片外层 Box 有 .clip(RoundedCornerShape) 会额外建一层 GraphicsLayer,挖洞与图层合成
  节奏一旦不同步,Compose 画的黑底就会盖住 SurfaceView —— 表现就是画面/纯黑高速交替闪
  (实测 46% 的合成帧为纯黑)。TextureView 是普通 View,直接画进窗口 buffer,不做独立图层合成,
  不存在这个竞争。surface_type 只能从 XML 设置,media3 未提供代码 setter,故这里用布局文件承载。
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
